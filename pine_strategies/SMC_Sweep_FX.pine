//@version=6
// =============================================================
// SMC_Sweep_FX  —  اصطياد السيولة (Liquidity Sweep) للفوركس (Pine v6)
// تحويل من user_data/strategies/SMC_Sweep_FX.py (البطل، اجتاز تحقق OOS)
// المفهوم: صانع السوق يكنس السيولة تحت قاع متأرجح (حيث أوامر الوقف)
//   ثم يعكس بسرعة فوق المستوى ⇒ "اصطياد سيولة" يسبق ارتداداً صاعداً.
// الأنسب: EUR/USD, AUD/USD, GBP/USD على فريم 1h (long only).
// عمق السيولة الأمثل n=40 (مثبت تجريبياً + OOS عبر 2024/2025).
// إدارة المخاطر: حجم المركز = (حقوق الملكية × المخاطرة%) ÷ مسافة الوقف%
// الإعداد الافتراضي: رأس مال $10,000، مخاطرة 1%، وقف 2.5%، رافعة 1:400.
// =============================================================
strategy("SMC_Sweep_FX",
     overlay          = true,
     initial_capital  = 10000,
     default_qty_type = strategy.cash,
     default_qty_value= 4000,
     commission_type  = strategy.commission.percent,
     commission_value = 0.005,                    // رسوم وسيط فوركس ECN واقعية/جانب
     pyramiding       = 0,
     process_orders_on_close = true,
     margin_long      = 0.25,                      // 1:400 ⇒ هامش 0.25%
     margin_short     = 0.25)

// ----------------------- المدخلات -----------------------
swingLb  = input.int(40,    "Swing Lookback (n)", minval = 10, maxval = 60)
rsiLen   = input.int(14,    "RSI Length",         minval = 2)
rsiEntry = input.int(50,    "RSI Entry max",      minval = 1, maxval = 100)
rsiExit  = input.int(65,    "RSI Exit",           minval = 1, maxval = 100)
roiPct   = input.float(2.0, "Take Profit %",      minval = 0.1, step = 0.1)
slPct    = input.float(2.5, "Stop Loss %",        minval = 0.1, step = 0.1)
riskPct  = input.float(1.0, "Risk per trade %",   minval = 0.1, step = 0.1)

// ----------------------- المؤشرات -----------------------
rsi = ta.rsi(close, rsiLen)
// قاع/قمة متأرجحة تستبعد الشمعة الحالية ([1]) لتجنّب lookahead — يطابق shift(1) في بايثون
swingLow  = ta.lowest(low,  swingLb)[1]
swingHigh = ta.highest(high, swingLb)[1]

// ----------------------- إدارة المخاطر -----------------------
riskAmount = strategy.equity * (riskPct / 100.0)
posSize    = riskAmount / (slPct / 100.0)

// ----------------------- الإشارات -----------------------
// دخول: كنس السيولة تحت القاع + استعادة المستوى + شمعة صاعدة + RSI ليس مرتفعاً
longEntry = (low < swingLow) and (close > swingLow) and (close > open) and (rsi < rsiEntry)
// خروج: العودة لأعلى قمة متأرجحة (الهدف) أو RSI مرتفع
longExit  = (close >= swingHigh) or (rsi > rsiExit)

if longEntry and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty = posSize / close, comment = "smc_sweep")

if longExit and strategy.position_size > 0
    strategy.close("L", comment = "smc_target")

// وقف/هدف ثابت كحماية (يطابق ROI/SL الموروث من v2)
if strategy.position_size > 0
    e  = strategy.position_avg_price
    tp = e * (1 + roiPct / 100.0)
    sl = e * (1 - slPct / 100.0)
    strategy.exit("L_exit", from_entry = "L", limit = tp, stop = sl)

// ----------------------- الرسم -----------------------
plot(swingLow,  "Swing Low",  color = color.new(color.red,  40))
plot(swingHigh, "Swing High", color = color.new(color.green, 40))
plotshape(longEntry and strategy.position_size == 0, "Sweep Buy",
     style = shape.triangleup, location = location.belowbar,
     color = color.green, size = size.tiny)
