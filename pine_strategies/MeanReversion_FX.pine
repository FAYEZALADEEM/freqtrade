//@version=6
// =============================================================
// MeanReversion_FX  —  استراتيجية ارتداد للفوركس (Pine v6)
// تحويل من MeanReversion_FX_v2.py مع إدارة مخاطر احترافية
// الأنسب: EUR/USD, AUD/USD, GBP/USD على فريم 1h (long only)
// إدارة المخاطر: كل صفقة تخاطر بنسبة ثابتة من رأس المال عبر مسافة الوقف.
//   حجم المركز = (رأس المال × المخاطرة%) ÷ مسافة الوقف%
// الإعداد الافتراضي: رأس مال $10,000، مخاطرة 1%، وقف 2.5%، رافعة 1:400.
// =============================================================
strategy("MeanReversion_FX",
     overlay          = true,
     initial_capital  = 10000,
     default_qty_type = strategy.cash,            // الحجم بالدولار (نحسبه بالمخاطرة)
     default_qty_value= 4000,                     // يُعاد حسابه ديناميكياً أدناه
     commission_type  = strategy.commission.percent,
     commission_value = 0.005,                    // رسوم وسيط فوركس واقعية/جانب
     pyramiding       = 0,
     process_orders_on_close = true,
     margin_long      = 0.25,                      // 1:400 ⇒ هامش 0.25%
     margin_short     = 0.25)

// ----------------------- المدخلات -----------------------
bbPeriod = input.int(20,    "Bollinger Period",   minval = 5)
bbStd    = input.float(2.5, "Bollinger StdDev",   minval = 0.5, step = 0.1)
rsiLen   = input.int(14,    "RSI Length",         minval = 2)
rsiBuy   = input.int(30,    "RSI Buy (oversold)", minval = 1, maxval = 100)
rsiExit  = input.int(55,    "RSI Exit",           minval = 1, maxval = 100)
roiPct   = input.float(2.0, "Take Profit %",      minval = 0.1, step = 0.1)
slPct    = input.float(2.5, "Stop Loss %",        minval = 0.1, step = 0.1)
riskPct  = input.float(1.0, "Risk per trade %",   minval = 0.1, step = 0.1)

// ----------------------- المؤشرات -----------------------
basis = ta.sma(close, bbPeriod)
dev   = bbStd * ta.stdev(close, bbPeriod)
bbLow = basis - dev
bbUp  = basis + dev
rsi   = ta.rsi(close, rsiLen)

// ----------------------- إدارة المخاطر -----------------------
// حجم المركز ($) = (حقوق الملكية × المخاطرة%) ÷ مسافة الوقف%
riskAmount = strategy.equity * (riskPct / 100.0)
posSize    = riskAmount / (slPct / 100.0)

// ----------------------- الإشارات -----------------------
longEntry = (close < bbLow) and (rsi < rsiBuy)
longExit  = (close > basis) or (rsi > rsiExit)

if longEntry and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty = posSize / close, comment = "mr_oversold")

if longExit and strategy.position_size > 0
    strategy.close("L", comment = "mr_revert")

if strategy.position_size > 0
    e  = strategy.position_avg_price
    tp = e * (1 + roiPct / 100.0)
    sl = e * (1 - slPct / 100.0)
    strategy.exit("L_exit", from_entry = "L", limit = tp, stop = sl)

// ----------------------- الرسم -----------------------
plot(basis, "BB Mid",   color = color.orange)
plot(bbUp,  "BB Upper", color = color.new(color.blue, 50))
plot(bbLow, "BB Lower", color = color.new(color.blue, 50))
plotshape(longEntry and strategy.position_size == 0, "Buy",
     style = shape.triangleup, location = location.belowbar,
     color = color.green, size = size.tiny)
