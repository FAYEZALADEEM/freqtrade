//@version=6
strategy(
     title = "Mean Reversion الإحصائي V1 — اختبار مستقل EURUSD M15",
     shorttitle = "MR ZScore V1",
     overlay = true,
     pyramiding = 0,
     initial_capital = 10000,
     currency = currency.USD,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0.0,
     slippage = 0,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     max_labels_count = 200
)

// ============================================================================
// استراتيجية Mean Reversion الإحصائي — نسخة اختبار مستقلة
// الأصل: Z-Score + Bollinger Bands + RSI(2) + ADX regime filter
// الزوج الأساسي: EUR/USD
// فريم التشغيل الموصى به لهذه النسخة: M15
// ملاحظة: اضبط السبريد/الانزلاق/العمولة من خصائص الاستراتيجية وفق وسيطك.
// ============================================================================

// ============================================================================
// 1) الإعدادات الأساسية
// ============================================================================
groupMain = "1) المؤشرات الأساسية"
basisLen       = input.int(20, "طول SMA / Bollinger / Z-Score", minval = 2, group = groupMain)
bbMult         = input.float(2.0, "انحراف Bollinger", minval = 0.1, step = 0.1, group = groupMain)
zTrigger       = input.float(2.0, "عتبة Z-Score للدخول", minval = 0.5, step = 0.1, group = groupMain)
zFailure       = input.float(2.8, "عتبة فشل Walking the Band", minval = 1.0, step = 0.1, group = groupMain)
rsiLen         = input.int(2, "طول RSI", minval = 1, group = groupMain)
rsiBuyLevel    = input.float(10.0, "RSI أقصى لإشارة الشراء", minval = 0, maxval = 50, step = 1, group = groupMain)
rsiSellLevel   = input.float(90.0, "RSI أدنى لإشارة البيع", minval = 50, maxval = 100, step = 1, group = groupMain)

groupRegime = "2) فلتر السوق العرضي"
diLen          = input.int(14, "طول DI / ADX", minval = 1, group = groupRegime)
adxSmooth      = input.int(14, "تنعيم ADX", minval = 1, group = groupRegime)
adxH1Max       = input.float(22.0, "أقصى ADX على H1", minval = 1, step = 0.5, group = groupRegime)
adxM15Max      = input.float(25.0, "أقصى ADX على M15", minval = 1, step = 0.5, group = groupRegime)
emaSlopeLen    = input.int(50, "EMA لسياق H1", minval = 2, group = groupRegime)
slopeBars      = input.int(20, "عدد شموع H1 لحساب الميل", minval = 1, group = groupRegime)
maxSlopePips   = input.float(0.3, "أقصى ميل EMA50 H1 — Pip/Bar", minval = 0, step = 0.1, group = groupRegime)

groupConfirm = "3) التأكيد والتنفيذ"
wickPct        = input.float(0.60, "نسبة الذيل المطلوبة في شمعة الإشارة", minval = 0.1, maxval = 1.0, step = 0.05, group = groupConfirm)
atrLen         = input.int(14, "طول ATR", minval = 1, group = groupConfirm)
slAtrMult      = input.float(0.8, "مسافة الوقف خلف Extreme × ATR", minval = 0.1, step = 0.1, group = groupConfirm)
maxHoldBars    = input.int(12, "الخروج الزمني بعد عدد شموع M15", minval = 1, group = groupConfirm)
extremeBars    = input.int(1, "شموع تحديد آخر Extreme — 1 = شمعة الإشارة", minval = 1, maxval = 20, group = groupConfirm)
useSession     = input.bool(false, "تفعيل نافذة جلسة تنفيذ اختيارية", group = groupConfirm)
tradeSession   = input.session("1200-1500:23456", "جلسة التنفيذ GMT — London/NY overlap", group = groupConfirm)
sessionTz      = input.string("GMT+0", "المنطقة الزمنية للجلسة", group = groupConfirm)

groupRisk = "4) حجم المخاطرة"
useRiskSizing  = input.bool(true, "حساب الكمية حسب نسبة المخاطرة — EURUSD وحساب USD", group = groupRisk)
riskPct        = input.float(0.50, "المخاطرة من رأس المال لكل صفقة %", minval = 0.01, maxval = 5.0, step = 0.05, group = groupRisk)
manualPip      = input.float(0.0, "قيمة Pip يدوياً — 0 = تلقائي", minval = 0.0, step = 0.00001, group = groupRisk)

groupView = "5) العرض"
showSignals    = input.bool(true, "إظهار إشارات الإعداد والدخول", group = groupView)
showPanel      = input.bool(true, "إظهار لوحة الإحصاءات", group = groupView)
showZLabels    = input.bool(false, "إظهار قيمة Z على شمعة الإعداد", group = groupView)

// ============================================================================
// 2) دوال مساعدة
// ============================================================================
pipAuto = syminfo.type == "forex" ? syminfo.mintick * 10.0 : syminfo.mintick
pip = manualPip > 0 ? manualPip : pipAuto

f_adx(_diLen, _smooth) =>
    [plusDI, minusDI, adxValue] = ta.dmi(_diLen, _smooth)
    adxValue

f_emaSlopePips(_emaLen, _bars, _pip) =>
    emaValue = ta.ema(close, _emaLen)
    (emaValue - emaValue[_bars]) / (_bars * _pip)

// ============================================================================
// 3) المؤشرات على فريم التنفيذ M15
// ============================================================================
basis = ta.sma(close, basisLen)
deviation = ta.stdev(close, basisLen)
upperBand = basis + bbMult * deviation
lowerBand = basis - bbMult * deviation
zScore = deviation > 0 ? (close - basis) / deviation : 0.0
rsiValue = ta.rsi(close, rsiLen)
atrValue = ta.atr(atrLen)
adxM15 = f_adx(diLen, adxSmooth)

// سياق H1 دون Lookahead
adxH1 = request.security(syminfo.tickerid, "60", f_adx(diLen, adxSmooth), barmerge.gaps_off, barmerge.lookahead_off)
slopeH1Pips = request.security(syminfo.tickerid, "60", f_emaSlopePips(emaSlopeLen, slopeBars, pip), barmerge.gaps_off, barmerge.lookahead_off)
emaH1 = request.security(syminfo.tickerid, "60", ta.ema(close, emaSlopeLen), barmerge.gaps_off, barmerge.lookahead_off)

isM15 = timeframe.isminutes and timeframe.multiplier == 15
insideTradeSession = not useSession or not na(time(timeframe.period, tradeSession, sessionTz))

regimeAllowed = adxH1 < adxH1Max and adxM15 < adxM15Max and math.abs(slopeH1Pips) < maxSlopePips

// ============================================================================
// 4) شمعة الإشارة: انحراف إحصائي + Bollinger + RSI + ذيل انعكاسي
// ============================================================================
candleRange = high - low
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
validCandle = candleRange > 0

longReversalWick = validCandle and lowerWick >= wickPct * candleRange
shortReversalWick = validCandle and upperWick >= wickPct * candleRange

rawLongSetup = strategy.position_size == 0 and regimeAllowed and insideTradeSession and zScore <= -zTrigger and close <= lowerBand and rsiValue < rsiBuyLevel and longReversalWick
rawShortSetup = strategy.position_size == 0 and regimeAllowed and insideTradeSession and zScore >= zTrigger and close >= upperBand and rsiValue > rsiSellLevel and shortReversalWick

// ============================================================================
// 5) حفظ الإشارة وانتظار الشمعة التالية فقط للتأكيد
// ============================================================================
var int pendingDirection = 0        // 1 شراء، -1 بيع، 0 لا يوجد
var int pendingBar = na
var float pendingExtreme = na

// شمعة التأكيد يجب أن تعود داخل Bollinger ويستمر فلتر السوق العرضي
newOutsideLongFailure = close < lowerBand - (1.5 * atrValue)
newOutsideShortFailure = close > upperBand + (1.5 * atrValue)

longConfirmation = pendingDirection == 1 and bar_index == pendingBar + 1 and regimeAllowed and insideTradeSession and close > lowerBand and close < upperBand and not newOutsideLongFailure
shortConfirmation = pendingDirection == -1 and bar_index == pendingBar + 1 and regimeAllowed and insideTradeSession and close < upperBand and close > lowerBand and not newOutsideShortFailure

// ============================================================================
// 6) مستويات الصفقة الثابتة عند الدخول
//    TP1 = مستوى Z ±1 وقت الدخول، TP2 = المتوسط SMA وقت الدخول
// ============================================================================
var float tradeEntry = na
var float tradeStop = na
var float tradeTp1 = na
var float tradeTp2 = na
var int tradeEntryBar = na

// لضمان أن السعر لم يصل فعلياً إلى الهدف قبل الدخول
longTargetsValid = longConfirmation and (basis - deviation) > close and basis > close
shortTargetsValid = shortConfirmation and (basis + deviation) < close and basis < close

if longTargetsValid
    lastExtreme = ta.lowest(low, extremeBars)[1]
    proposedStop = lastExtreme - slAtrMult * atrValue
    stopDistance = close - proposedStop
    orderQty = useRiskSizing and stopDistance > 0 ? (strategy.equity * riskPct / 100.0) / stopDistance : na

    if stopDistance > 0
        tradeEntry := close
        tradeStop := proposedStop
        tradeTp1 := basis - deviation
        tradeTp2 := basis
        tradeEntryBar := bar_index
        strategy.entry("شراء MR", strategy.long, qty = orderQty)
    pendingDirection := 0
    pendingBar := na
    pendingExtreme := na

if shortTargetsValid
    lastExtreme = ta.highest(high, extremeBars)[1]
    proposedStop = lastExtreme + slAtrMult * atrValue
    stopDistance = proposedStop - close
    orderQty = useRiskSizing and stopDistance > 0 ? (strategy.equity * riskPct / 100.0) / stopDistance : na

    if stopDistance > 0
        tradeEntry := close
        tradeStop := proposedStop
        tradeTp1 := basis + deviation
        tradeTp2 := basis
        tradeEntryBar := bar_index
        strategy.entry("بيع MR", strategy.short, qty = orderQty)
    pendingDirection := 0
    pendingBar := na
    pendingExtreme := na

// إذا انتهت شمعة التأكيد دون دخول، تلغى الإشارة
confirmationExpired = pendingDirection != 0 and bar_index >= pendingBar + 1 and not longTargetsValid and not shortTargetsValid
if confirmationExpired
    pendingDirection := 0
    pendingBar := na
    pendingExtreme := na

// تسجيل الإعداد الجديد لا يتم إلا بعد التعامل مع تأكيد الإعداد السابق
if strategy.position_size == 0 and pendingDirection == 0
    if rawLongSetup
        pendingDirection := 1
        pendingBar := bar_index
        pendingExtreme := ta.lowest(low, extremeBars)
    else if rawShortSetup
        pendingDirection := -1
        pendingBar := bar_index
        pendingExtreme := ta.highest(high, extremeBars)

// ============================================================================
// 7) أوامر الخروج: TP جزئي + TP أساسي + وقف + وقت + فشل Walking the Band
// ============================================================================
if strategy.position_size > 0 and not na(tradeStop)
    strategy.exit("شراء TP1", from_entry = "شراء MR", stop = tradeStop, limit = tradeTp1, qty_percent = 50)
    strategy.exit("شراء TP2", from_entry = "شراء MR", stop = tradeStop, limit = tradeTp2, qty_percent = 50)

    walkingBandLong = zScore < -zFailure and close < lowerBand
    timeExitLong = not na(tradeEntryBar) and bar_index - tradeEntryBar >= maxHoldBars

    if walkingBandLong
        strategy.close("شراء MR", comment = "فشل: Walking the Band")
    else if timeExitLong
        strategy.close("شراء MR", comment = "خروج زمني")

if strategy.position_size < 0 and not na(tradeStop)
    strategy.exit("بيع TP1", from_entry = "بيع MR", stop = tradeStop, limit = tradeTp1, qty_percent = 50)
    strategy.exit("بيع TP2", from_entry = "بيع MR", stop = tradeStop, limit = tradeTp2, qty_percent = 50)

    walkingBandShort = zScore > zFailure and close > upperBand
    timeExitShort = not na(tradeEntryBar) and bar_index - tradeEntryBar >= maxHoldBars

    if walkingBandShort
        strategy.close("بيع MR", comment = "فشل: Walking the Band")
    else if timeExitShort
        strategy.close("بيع MR", comment = "خروج زمني")

// تنظيف المستويات بعد إغلاق الصفقة
if strategy.position_size == 0 and strategy.position_size[1] != 0
    tradeEntry := na
    tradeStop := na
    tradeTp1 := na
    tradeTp2 := na
    tradeEntryBar := na

// ============================================================================
// 8) العرض على الشارت
// ============================================================================
basisPlot = plot(basis, "SMA 20 / هدف العودة للوسط", color = color.new(color.yellow, 0), linewidth = 2)
upperPlot = plot(upperBand, "Bollinger Upper", color = color.new(color.blue, 0), linewidth = 1)
lowerPlot = plot(lowerBand, "Bollinger Lower", color = color.new(color.blue, 0), linewidth = 1)
fill(upperPlot, lowerPlot, color = color.new(color.blue, 92), title = "Bollinger Range")

plot(emaH1, "EMA50 H1", color = color.new(color.orange, 25), linewidth = 1)

plotshape(showSignals and rawLongSetup, title = "إعداد شراء", text = "إعداد شراء", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 30), textcolor = color.white, size = size.tiny)
plotshape(showSignals and rawShortSetup, title = "إعداد بيع", text = "إعداد بيع", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 30), textcolor = color.white, size = size.tiny)
plotshape(showSignals and longTargetsValid, title = "دخول شراء مؤكد", text = "شراء", style = shape.triangleup, location = location.belowbar, color = color.lime, textcolor = color.black, size = size.small)
plotshape(showSignals and shortTargetsValid, title = "دخول بيع مؤكد", text = "بيع", style = shape.triangledown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.small)

plot(strategy.position_size != 0 ? tradeStop : na, "وقف الخسارة", color = color.red, linewidth = 2, style = plot.style_linebr)
plot(strategy.position_size != 0 ? tradeTp1 : na, "TP1 — Z ±1", color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)
plot(strategy.position_size != 0 ? tradeTp2 : na, "TP2 — SMA", color = color.new(color.green, 0), linewidth = 2, style = plot.style_linebr)

if showZLabels and rawLongSetup
    label.new(bar_index, low, "Z: " + str.tostring(zScore, "#.##"), style = label.style_label_up, textcolor = color.white, color = color.new(color.green, 20))
if showZLabels and rawShortSetup
    label.new(bar_index, high, "Z: " + str.tostring(zScore, "#.##"), style = label.style_label_down, textcolor = color.white, color = color.new(color.red, 20))

// ============================================================================
// 9) لوحة الفحص والإحصاءات
// ============================================================================
closedTrades = strategy.closedtrades
winRate = closedTrades > 0 ? (strategy.wintrades / closedTrades) * 100.0 : 0.0
profitFactor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
pendingText = pendingDirection == 1 ? "شراء — انتظار تأكيد" : pendingDirection == -1 ? "بيع — انتظار تأكيد" : "لا يوجد"
regimeText = regimeAllowed ? "Range مسموح" : "اتجاهي / مرفوض"

var table panel = table.new(position.top_right, 2, 10, border_width = 1)

if barstate.islast and showPanel
    table.cell(panel, 0, 0, "Mean Reversion", bgcolor = color.new(color.blue, 70), text_color = color.white)
    table.cell(panel, 1, 0, "EURUSD M15", bgcolor = color.new(color.blue, 70), text_color = color.white)
    table.cell(panel, 0, 1, "الفريم")
    table.cell(panel, 1, 1, isM15 ? "M15 ✓" : "استخدم M15", text_color = isM15 ? color.lime : color.orange)
    table.cell(panel, 0, 2, "Z-Score")
    table.cell(panel, 1, 2, str.tostring(zScore, "#.##"))
    table.cell(panel, 0, 3, "ADX M15 / H1")
    table.cell(panel, 1, 3, str.tostring(adxM15, "#.0") + " / " + str.tostring(adxH1, "#.0"))
    table.cell(panel, 0, 4, "ميل EMA H1")
    table.cell(panel, 1, 4, str.tostring(slopeH1Pips, "#.##") + " pip/bar")
    table.cell(panel, 0, 5, "حالة السوق")
    table.cell(panel, 1, 5, regimeText, text_color = regimeAllowed ? color.lime : color.red)
    table.cell(panel, 0, 6, "الإشارة")
    table.cell(panel, 1, 6, pendingText)
    table.cell(panel, 0, 7, "إجمالي الصفقات")
    table.cell(panel, 1, 7, str.tostring(closedTrades))
    table.cell(panel, 0, 8, "نسبة النجاح")
    table.cell(panel, 1, 8, str.tostring(winRate, "#.##") + "%")
    table.cell(panel, 0, 9, "PF / الصافي")
    table.cell(panel, 1, 9, (na(profitFactor) ? "—" : str.tostring(profitFactor, "#.##")) + " / " + str.tostring(strategy.netprofit, "#.##"))

// تنبيه واضح إذا شغّلت الاستراتيجية على فريم مختلف عن فريم التصميم
bgcolor(not isM15 ? color.new(color.orange, 90) : na, title = "تنبيه: استخدم فريم M15")
