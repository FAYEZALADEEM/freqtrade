//@version=6
strategy("02 - ICT Silver Bullet Liquidity Sweep FVG", overlay = true, pyramiding = 0, process_orders_on_close = true)

// افتراض برمجي: FVG صاعد عندما low الحالي أعلى من high قبل شمعتين، وFVG هابط عندما high الحالي أدنى من low قبل شمعتين. retest يحدث عند عودة السعر إلى حدود الفجوة بعد sweep مؤكد.
grp01 = "01) الإعدادات العامة"
grp02 = "02) تفعيل الاتجاهات"
grp03 = "03) إعدادات الإشارة"
grp04 = "04) فلاتر التأكيد"
grp06 = "06) وقف الخسارة والهدف"
grp07 = "07) التعادل Break Even"
grp09 = "09) فلتر الجلسة"
grp10 = "10) العرض والتنبيهات"
pipSize = input.float(0.0001, "حجم النقطة", step = 0.00001, group = grp01, tooltip = "حجم النقطة المستخدم في حساب الوقف والهدف.")
enableLong = input.bool(true, "تفعيل الشراء", group = grp02, tooltip = "يسمح بصفقات الشراء عند ظهور إشارة صاعدة.")
enableShort = input.bool(true, "تفعيل البيع", group = grp02, tooltip = "يسمح بصفقات البيع عند ظهور إشارة هابطة.")
pivotLen = input.int(5, "طول سيولة القمم والقيعان", minval = 2, maxval = 50, group = grp03, tooltip = "يحدد القمم والقيعان التي تعتبر مناطق سيولة للسحب.")
maxRetestBars = input.int(20, "أقصى عدد شموع لإعادة اختبار FVG", minval = 1, maxval = 200, group = grp03, tooltip = "عدد الشموع المسموح بها بين تكوّن FVG وعودة السعر إليه.")
useBias = input.bool(false, "تفعيل فلتر EMA للانحياز", group = grp04, tooltip = "عند التفعيل يتم فلترة الشراء أعلى EMA والبيع أسفل EMA.")
biasEmaLen = input.int(50, "طول EMA للانحياز", minval = 1, maxval = 300, group = grp04, tooltip = "طول المتوسط المستخدم كبديل برمجي مبسط للـDaily Bias.")
stopLossPips = input.float(20.0, "وقف الخسارة بالنقاط", minval = 1.0, group = grp06, tooltip = "مسافة الوقف الافتراضية بالنقاط.")
rr = input.float(3.0, "نسبة الهدف إلى المخاطرة", minval = 0.5, step = 0.1, group = grp06, tooltip = "الملف ذكر حدًا أدنى 1:3 لهذه الاستراتيجية.")
useBreakEven = input.bool(false, "تفعيل التعادل", group = grp07, tooltip = "ينقل الوقف إلى نقطة الدخول بعد تحقق حركة ربح محددة.")
breakEvenAfterPips = input.float(15.0, "تفعيل التعادل بعد", minval = 1.0, group = grp07, tooltip = "عدد النقاط المطلوبة قبل تفعيل التعادل.")
useSessionFilter = input.bool(false, "تفعيل فلتر الجلسة", group = grp09, tooltip = "فلتر الجلسة معطل افتراضياً كما هو مطلوب.")
tradeSession = input.session("1000-1100", "وقت Silver Bullet", group = grp09, tooltip = "نافذة Silver Bullet المقترحة؛ لا تعمل إلا عند تفعيل فلتر الجلسة.")
showMarks = input.bool(true, "عرض العلامات", group = grp10, tooltip = "يعرض علامات الإشارات على الشارت.")

inSession = not useSessionFilter or not na(time(timeframe.period, tradeSession))
emaBias = ta.ema(close, biasEmaLen)
biasLong = not useBias or close > emaBias
biasShort = not useBias or close < emaBias
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
liqHigh = ta.valuewhen(not na(ph), ph, 0)
liqLow = ta.valuewhen(not na(pl), pl, 0)
sweepLow = low < liqLow and close > liqLow
sweepHigh = high > liqHigh and close < liqHigh
bullFvg = low > high[2]
bearFvg = high < low[2]
var float bullTop = na
var float bullBot = na
var int bullBar = na
var float bearTop = na
var float bearBot = na
var int bearBar = na
if sweepLow[1] and bullFvg
    bullTop := low
    bullBot := high[2]
    bullBar := bar_index
if sweepHigh[1] and bearFvg
    bearTop := low[2]
    bearBot := high
    bearBar := bar_index
longSignal = enableLong and inSession and biasLong and not na(bullBar) and bar_index - bullBar <= maxRetestBars and low <= bullTop and close > bullBot
shortSignal = enableShort and inSession and biasShort and not na(bearBar) and bar_index - bearBar <= maxRetestBars and high >= bearBot and close < bearTop
if longSignal
    strategy.entry("شراء Silver", strategy.long)
if shortSignal
    strategy.entry("بيع Silver", strategy.short)
longStop = (useBreakEven and strategy.position_size > 0 and close >= strategy.position_avg_price + breakEvenAfterPips * pipSize) ? strategy.position_avg_price : strategy.position_avg_price - stopLossPips * pipSize
shortStop = (useBreakEven and strategy.position_size < 0 and close <= strategy.position_avg_price - breakEvenAfterPips * pipSize) ? strategy.position_avg_price : strategy.position_avg_price + stopLossPips * pipSize
strategy.exit("خروج شراء Silver", "شراء Silver", stop = longStop, limit = strategy.position_avg_price + stopLossPips * pipSize * rr)
strategy.exit("خروج بيع Silver", "بيع Silver", stop = shortStop, limit = strategy.position_avg_price - stopLossPips * pipSize * rr)
plotshape(showMarks and longSignal, title = "إشارة شراء", style = shape.triangleup, location = location.belowbar, text = "شراء", color = color.lime, textcolor = color.white)
plotshape(showMarks and shortSignal, title = "إشارة بيع", style = shape.triangledown, location = location.abovebar, text = "بيع", color = color.red, textcolor = color.white)
alertcondition(longSignal, title = "تنبيه شراء", message = "ظهرت إشارة شراء ICT Silver Bullet")
alertcondition(shortSignal, title = "تنبيه بيع", message = "ظهرت إشارة بيع ICT Silver Bullet")
