//@version=6
// =============================================================
// MeanReversion_FX — نسخة مؤشر (Indicator) لعرض الصفقات بصرياً
// يعيد حساب منطق الارتداد المُختبَر (BB 20/2.5 + RSI) ويرسم كل صفقة محاكاة.
// البوت الثاني في المحفظة (مع SMC_Sweep). الأنسب: EUR/USD, AUD/USD, GBP/USD على 1h.
// أداة معاينة بصرية فقط — ليست استراتيجية تنفيذ.
// =============================================================
indicator("MeanReversion_FX — مؤشر معاينة الصفقات", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ----------------------- المدخلات (tooltip عربي بجانب كل إعداد) -----------------------
bbPeriod = input.int(20, "فترة بولنجر",
     tooltip = "عدد الشموع لحساب المتوسط والانحراف. 20 = قياسي.")
bbStd    = input.float(2.5, "انحراف بولنجر", step = 0.1,
     tooltip = "عرض الحاشية = كم انحراف معياري عن المتوسط. 2.5 = حاشية واسعة تلتقط تشبّعاً بيعياً أوضح (إشارات أقل وأجود).")
rsiBuy   = input.int(30, "حدّ RSI للشراء",
     tooltip = "نشتري حين RSI أقل من هذا الحد (تشبّع بيعي). 30 = القياسي للارتداد.")
rsiExit  = input.int(55, "حدّ RSI للخروج",
     tooltip = "نخرج حين يرتفع RSI فوق هذا الحد — أو عند عودة السعر فوق متوسط بولنجر.")
slPct    = input.float(2.5, "وقف الخسارة %", step = 0.1,
     tooltip = "مسافة الوقف من الدخول. الارتداد يحتاج وقفاً واسعاً ليعطي السعر مجال العودة للمتوسط.")
tpPct    = input.float(2.0, "الهدف الواقي %", step = 0.1,
     tooltip = "هدف ربح احتياطي. الخروج الأساسي عند المتوسط أو RSI.")
showBands = input.bool(true, "إظهار حواشي بولنجر",
     tooltip = "رسم الحاشية العليا/السفلى والمتوسط المستخدمة في الإشارات.")

// ----------------------- المؤشرات -----------------------
basis = ta.sma(close, bbPeriod)
dev   = bbStd * ta.stdev(close, bbPeriod)
bbLow = basis - dev
bbUp  = basis + dev
rsi   = ta.rsi(close, 14)

// ----------------------- الإشارات -----------------------
longSignal = (close < bbLow) and (rsi < rsiBuy)
exitSignal = (close > basis) or (rsi > rsiExit)

// ----------------------- محاكاة الصفقات (خانة واحدة) -----------------------
var bool  inTrade    = false
var float entryPrice = na
var int   entryBar   = na
var float slLevel    = na
var float tpLevel    = na

if longSignal and not inTrade
    inTrade    := true
    entryPrice := close
    entryBar   := bar_index
    slLevel    := close * (1 - slPct / 100.0)
    tpLevel    := close * (1 + tpPct / 100.0)
    label.new(bar_index, low, "▲ دخول", color = color.new(color.green, 20),
         style = label.style_label_up, textcolor = color.white, size = size.small,
         tooltip = "دخول ارتداد (تشبّع بيعي)\nالسعر: " + str.tostring(close, format.mintick))

hitSL   = inTrade and low  <= slLevel
hitTP   = inTrade and high >= tpLevel
sigExit = inTrade and exitSignal

if inTrade and (hitSL or hitTP or sigExit)
    float exitPrice = hitSL ? slLevel : hitTP ? tpLevel : close
    float pnlPct    = (exitPrice - entryPrice) / entryPrice * 100.0
    bool  win       = pnlPct > 0
    string reason   = hitSL ? "وقف خسارة" : hitTP ? "هدف واقٍ" : "متوسط/RSI"
    line.new(entryBar, entryPrice, bar_index, exitPrice,
         color = win ? color.new(color.green, 0) : color.new(color.red, 0), width = 2)
    label.new(bar_index, high, "▼ خروج", color = win ? color.new(color.green, 40) : color.new(color.red, 30),
         style = label.style_label_down, textcolor = color.white, size = size.small,
         tooltip = "سبب الخروج: " + reason + "\nالربح: " + str.tostring(pnlPct, "#.##") + "%" +
                   "\nدخول: " + str.tostring(entryPrice, format.mintick) +
                   "\nخروج: " + str.tostring(exitPrice, format.mintick))
    inTrade := false

// ----------------------- الرسم -----------------------
plot(showBands ? basis : na, "متوسط بولنجر", color = color.new(color.orange, 0))
plot(showBands ? bbUp  : na, "الحاشية العليا", color = color.new(color.blue, 50))
plot(showBands ? bbLow : na, "الحاشية السفلى", color = color.new(color.blue, 50))
bgcolor(inTrade ? color.new(color.blue, 92) : na, title = "صفقة مفتوحة")
