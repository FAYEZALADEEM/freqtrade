//@version=6
strategy("11 - One Hour Forex Reversal", overlay = true, pyramiding = 0, process_orders_on_close = true)

// افتراض برمجي: التقرير ذكر قواعد البيع أساسًا. تم عكس القواعد للشراء بشكل متماثل حتى تبقى إشارات الشراء والبيع منفصلة وقابلة للتفعيل.
grp01 = "01) الإعدادات العامة"
grp02 = "02) تفعيل الاتجاهات"
grp03 = "03) إعدادات الإشارة"
grp06 = "06) وقف الخسارة والهدف"
grp07 = "07) التعادل Break Even"
grp09 = "09) فلتر الجلسة"
grp10 = "10) العرض والتنبيهات"
pipSize = input.float(0.0001, "حجم النقطة", step = 0.00001, group = grp01, tooltip = "حجم النقطة المستخدم في حساب الوقف والهدف.")
enableLong = input.bool(true, "تفعيل الشراء", group = grp02, tooltip = "يسمح بالشراء عند شروط oversold العكسية.")
enableShort = input.bool(true, "تفعيل البيع", group = grp02, tooltip = "يسمح بالبيع حسب القواعد الأصلية المذكورة.")
wmaLen = input.int(14, "طول WMA", minval = 1, maxval = 200, group = grp03, tooltip = "طول Weighted Moving Average المذكور في التقرير.")
stochLen = input.int(14, "طول Stochastic K", minval = 1, maxval = 100, group = grp03, tooltip = "قيمة K في Stochastic.")
stochD = input.int(3, "طول Stochastic D", minval = 1, maxval = 50, group = grp03, tooltip = "قيمة D في Stochastic.")
stochSmooth = input.int(3, "تنعيم Stochastic", minval = 1, maxval = 50, group = grp03, tooltip = "قيمة التنعيم في Stochastic.")
psarStart = input.float(0.02, "PSAR Start", minval = 0.001, step = 0.001, group = grp03, tooltip = "قيمة البداية في Parabolic SAR.")
psarInc = input.float(0.02, "PSAR Increment", minval = 0.001, step = 0.001, group = grp03, tooltip = "قيمة الزيادة في Parabolic SAR.")
psarMax = input.float(0.2, "PSAR Max", minval = 0.01, step = 0.01, group = grp03, tooltip = "القيمة القصوى في Parabolic SAR.")
stopLossPips = input.float(20.0, "وقف الخسارة بالنقاط", minval = 1.0, group = grp06, tooltip = "وقف الخسارة الافتراضي لأن التقرير لم يذكر وقفًا محددًا.")
rr = input.float(2.0, "نسبة الهدف إلى المخاطرة", minval = 0.5, step = 0.1, group = grp06, tooltip = "مضاعف الهدف مقابل الوقف.")
useBreakEven = input.bool(false, "تفعيل التعادل", group = grp07, tooltip = "ينقل الوقف إلى الدخول بعد ربح محدد.")
breakEvenAfterPips = input.float(15.0, "تفعيل التعادل بعد", minval = 1.0, group = grp07, tooltip = "عدد النقاط المطلوبة قبل التعادل.")
useSessionFilter = input.bool(false, "تفعيل فلتر الجلسة", group = grp09, tooltip = "فلتر الجلسة معطل افتراضياً.")
tradeSession = input.session("0000-2359", "وقت الجلسة", group = grp09, tooltip = "وقت التداول عند تفعيل فلتر الجلسة.")
showMarks = input.bool(true, "عرض العلامات", group = grp10, tooltip = "يعرض إشارات الشراء والبيع.")

inSession = not useSessionFilter or not na(time(timeframe.period, tradeSession))
wma = ta.wma(close, wmaLen)
psar = ta.sar(psarStart, psarInc, psarMax)
kRaw = ta.stoch(close, high, low, stochLen)
k = ta.sma(kRaw, stochSmooth)
d = ta.sma(k, stochD)
longSignal = enableLong and inSession and k < 20 and psar < close and close > wma
shortSignal = enableShort and inSession and k > 80 and psar > close and close < wma
if longSignal
    strategy.entry("شراء 1H Reversal", strategy.long)
if shortSignal
    strategy.entry("بيع 1H Reversal", strategy.short)
longStop = useBreakEven and strategy.position_size > 0 and close >= strategy.position_avg_price + breakEvenAfterPips * pipSize ? strategy.position_avg_price : strategy.position_avg_price - stopLossPips * pipSize
shortStop = useBreakEven and strategy.position_size < 0 and close <= strategy.position_avg_price - breakEvenAfterPips * pipSize ? strategy.position_avg_price : strategy.position_avg_price + stopLossPips * pipSize
strategy.exit("خروج شراء 1H Reversal", "شراء 1H Reversal", stop = longStop, limit = strategy.position_avg_price + stopLossPips * pipSize * rr)
strategy.exit("خروج بيع 1H Reversal", "بيع 1H Reversal", stop = shortStop, limit = strategy.position_avg_price - stopLossPips * pipSize * rr)
plot(wma, "WMA", color = color.orange)
plot(psar, "PSAR", style = plot.style_cross, color = color.gray)
plotshape(showMarks and longSignal, title = "إشارة شراء", style = shape.triangleup, location = location.belowbar, text = "شراء", color = color.lime, textcolor = color.white)
plotshape(showMarks and shortSignal, title = "إشارة بيع", style = shape.triangledown, location = location.abovebar, text = "بيع", color = color.red, textcolor = color.white)
alertcondition(longSignal, title = "تنبيه شراء", message = "ظهرت إشارة شراء 1-Hour Forex Reversal")
alertcondition(shortSignal, title = "تنبيه بيع", message = "ظهرت إشارة بيع 1-Hour Forex Reversal")
