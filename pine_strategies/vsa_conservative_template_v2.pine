//@version=6
strategy("VSA Conservative Template v2 (Arabic Source-Constrained)", overlay=true, pyramiding=0, initial_capital=25000, commission_type=strategy.commission.percent, commission_value=0.0, process_orders_on_close=true)

// ============================================================================
// نسخة مصححة لأن النسخة السابقة كانت شديدة التقييد وقد لا تنتج صفقات على كثير من الرموز.
// هذه النسخة ما زالت مقيّدة بالنص، لكنها تضيف مفاتيح تشغيل/تعطيل للفلاتر الصارمة وتسمح
// بالدخول Market أو Stop حتى يمكن اختبار المنهج عملياً.
// ============================================================================

// ---------------------------
// Inputs
// ---------------------------
volLen              = input.int(20,  "Volume average length")
spreadLen           = input.int(20,  "Spread average length")
backgroundBars      = input.int(50,  "Background lookback bars")
newGroundLookback   = input.int(200, "New ground lookback for End of Rising Market [يتطلب مراجعة]")
riskPct             = input.float(2.5, "Risk % per trade", step=0.1, minval=0.1)
rrMultiple          = input.float(3.0, "Reward/Risk multiple", step=0.1, minval=0.1)
entryBufferTicks    = input.int(1,   "Entry buffer (ticks) [يتطلب مراجعة]", minval=0)
stopBufferTicks     = input.int(1,   "Stop buffer (ticks) [يتطلب مراجعة]", minval=0)

// عتبات تقريبية لأنها غير معرفة رقمياً في النص.
narrowSpreadFactor  = input.float(0.9, "Narrow spread factor [يتطلب مراجعة]", step=0.05)
wideSpreadFactor    = input.float(1.3, "Wide spread factor [يتطلب مراجعة]", step=0.05)
ultraVolFactor      = input.float(1.5, "Ultra volume factor [يتطلب مراجعة]", step=0.05)
nearHighFrac        = input.float(0.70,"Close near high fraction [يتطلب مراجعة]", step=0.05, minval=0.5, maxval=1.0)
nearLowFrac         = input.float(0.30,"Close near low fraction [يتطلب مراجعة]", step=0.05, minval=0.0, maxval=0.5)
midTolerance        = input.float(0.25,"Mid-close tolerance [يتطلب مراجعة]", step=0.01, minval=0.01, maxval=0.49)

// مفاتيح لتخفيف الصرامة
entryMode           = input.string("Market on confirmation", "Entry mode", options=["Market on confirmation", "Stop above/below signal"])
useBackgroundFilter = input.bool(true,  "Require recent background strength/weakness")
useTrendFilter      = input.bool(true,  "Use EMA trend filter [تقريب]")
useAboveStrength    = input.bool(false, "Require close above Shake-out high for longs")
allowLongs          = input.bool(true,  "Allow Longs")
allowShorts         = input.bool(true,  "Allow Shorts")

emaFastLen          = input.int(20, "EMA fast [تقريب]", minval=1)
emaSlowLen          = input.int(50, "EMA slow [تقريب]", minval=1)

// ---------------------------
// Core bar math from the text: volume + spread + close location
// ---------------------------
spread      = high - low
avgSpread   = ta.sma(spread, spreadLen)
avgVol      = ta.sma(volume, volLen)
closePos    = spread > 0 ? (close - low) / spread : 0.5
isUpBar     = close > close[1]
isDownBar   = close < close[1]
smallSpread = spread < avgSpread * narrowSpreadFactor
wideSpread  = spread > avgSpread * wideSpreadFactor
ultraVol    = volume > avgVol * ultraVolFactor

entryBuffer = syminfo.mintick * entryBufferTicks
stopBuffer  = syminfo.mintick * stopBufferTicks

closeNearHigh = closePos >= nearHighFrac
closeNearLow  = closePos <= nearLowFrac
closeNearMid  = math.abs(closePos - 0.5) <= midTolerance

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
trendUp = emaFast > emaSlow
trendDn = emaFast < emaSlow

// ---------------------------
// Candidate background signals (approximations constrained by the text)
// ---------------------------
endOfRisingMarket = isUpBar and ultraVol and smallSpread and closeNearMid and high >= ta.highest(high, newGroundLookback)
shakeout          = isDownBar and wideSpread and ultraVol and closeNearHigh

lastWeakHigh   = ta.valuewhen(endOfRisingMarket, high, 0)
lastWeakLow    = ta.valuewhen(endOfRisingMarket, low, 0)
lastStrongHigh = ta.valuewhen(shakeout, high, 0)
lastStrongLow  = ta.valuewhen(shakeout, low, 0)

weakBgActive   = ta.barssince(endOfRisingMarket) >= 0 and ta.barssince(endOfRisingMarket) <= backgroundBars
strongBgActive = ta.barssince(shakeout) >= 0 and ta.barssince(shakeout) <= backgroundBars

// ---------------------------
// No Demand / No Supply from the text
// ---------------------------
noDemandBar       = isUpBar and smallSpread and volume < volume[1] and volume < volume[2]
noDemandConfirmed = noDemandBar[1] and close < close[1]

noSupplyBar       = isDownBar and smallSpread and volume < volume[1] and volume < volume[2]
noSupplyConfirmed = noSupplyBar[1] and close > close[1] and volume > volume[1]

aboveStrengthHigh = na(lastStrongHigh) ? false : close > lastStrongHigh

longContextOk  = (not useBackgroundFilter or strongBgActive) and (not useTrendFilter or trendUp) and (not useAboveStrength or aboveStrengthHigh)
shortContextOk = (not useBackgroundFilter or weakBgActive)   and (not useTrendFilter or trendDn)

// ---------------------------
// Risk sizing helpers
// ---------------------------
riskCapital = strategy.equity * (riskPct / 100.0)

calcQty(entryPrice, stopPrice) =>
    riskPerUnit = math.abs(entryPrice - stopPrice)
    riskPerUnit > 0 ? (riskCapital / riskPerUnit) : na

// ---------------------------
// Build/submit Long
// ---------------------------
if strategy.position_size == 0 and allowLongs and noSupplyConfirmed and longContextOk and not na(lastStrongLow)
    float signalHigh = high[1]
    float stopPrice  = lastStrongLow - stopBuffer
    float entryPrice = entryMode == "Market on confirmation" ? close : signalHigh + entryBuffer
    float qty        = calcQty(entryPrice, stopPrice)
    if not na(qty) and entryPrice > stopPrice
        if entryMode == "Market on confirmation"
            strategy.entry("Long", strategy.long, qty=qty)
        else
            strategy.entry("Long", strategy.long, qty=qty, stop=entryPrice)
        strategy.exit("Long Exit", from_entry="Long", stop=stopPrice, limit=entryPrice + (entryPrice - stopPrice) * rrMultiple)

// ---------------------------
// Build/submit Short
// ---------------------------
if strategy.position_size == 0 and allowShorts and noDemandConfirmed and shortContextOk and not na(lastWeakHigh)
    float signalLow  = low[1]
    float stopPrice  = lastWeakHigh + stopBuffer
    float entryPrice = entryMode == "Market on confirmation" ? close : signalLow - entryBuffer
    float qty        = calcQty(entryPrice, stopPrice)
    if not na(qty) and entryPrice < stopPrice
        if entryMode == "Market on confirmation"
            strategy.entry("Short", strategy.short, qty=qty)
        else
            strategy.entry("Short", strategy.short, qty=qty, stop=entryPrice)
        strategy.exit("Short Exit", from_entry="Short", stop=stopPrice, limit=entryPrice - (stopPrice - entryPrice) * rrMultiple)

// ---------------------------
// Visuals
// ---------------------------
plot(emaFast, "EMA Fast", color=color.new(color.green, 0))
plot(emaSlow, "EMA Slow", color=color.new(color.red, 0))
plotshape(endOfRisingMarket, title="End of Rising Market (candidate)", style=shape.triangledown, color=color.red, location=location.abovebar, size=size.tiny, text="EORM")
plotshape(shakeout, title="Shake-out (candidate)", style=shape.triangleup, color=color.lime, location=location.belowbar, size=size.tiny, text="SO")
plotshape(noDemandBar, title="No Demand", style=shape.circle, color=color.orange, location=location.abovebar, size=size.tiny, text="ND")
plotshape(noSupplyBar, title="No Supply", style=shape.circle, color=color.aqua, location=location.belowbar, size=size.tiny, text="NS")
plotshape(noDemandConfirmed and shortContextOk, title="Short Setup", style=shape.labeldown, color=color.red, location=location.abovebar, size=size.tiny, text="SELL")
plotshape(noSupplyConfirmed and longContextOk, title="Long Setup", style=shape.labelup, color=color.green, location=location.belowbar, size=size.tiny, text="BUY")

plotchar(weakBgActive, title="Weak BG active", char="W", location=location.top, color=color.red, size=size.tiny)
plotchar(strongBgActive, title="Strong BG active", char="S", location=location.bottom, color=color.green, size=size.tiny)
